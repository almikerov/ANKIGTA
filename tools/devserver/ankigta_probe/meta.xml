<meta>
    <info
        author="ANKIGTA"
        name="ANKIGTA dev control"
        version="2.0.0"
        type="script"
        description="DEVELOPMENT ONLY. A file-driven control channel for a local server."
    />
    <!-- Read `README.md` before putting this anywhere but a local dev box:
         `exec` runs arbitrary server Lua, so anyone who can write a file in
         this folder can run code as the server. -->
    <script src="server.lua" type="server" />
    <min_mta_version server="1.6.0" />

    <aclrequest>
        <right name="function.refreshResources" access="true" />
        <right name="function.restartResource" access="true" />
        <right name="function.startResource" access="true" />
        <right name="function.stopResource" access="true" />
        <right name="function.loadstring" access="true" />
        <right name="function.aclCreateGroup" access="true" />
        <right name="function.aclGroupAddObject" access="true" />
        <right name="function.aclSetRight" access="true" />
        <right name="function.aclSave" access="true" />
        <right name="function.aclReload" access="true" />
        <right name="function.shutdown" access="true" />
    </aclrequest>
</meta>
