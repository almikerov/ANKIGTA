<meta xmlns:edf="urn:mta:edf">
    <info
        author="ANKIGTA"
        name="ANKIGTA"
        version="1.0.0"
        type="script"
        edf:definition="ankigta.edf"
    />
    <min_mta_version server="1.6.0-9.24124.0" client="1.6.0-9.24124.0" />
    <script src="shared/settings.lua" type="shared" />
    <script src="shared/locale.lua" type="shared" />
    <!-- Both the Activation Zone and the Next Card Indicator pick "the nearest
         one". They share the order so they cannot drift into two answers. -->
    <script src="shared/nearest.lua" type="shared" />
    <script src="shared/entity_types.lua" type="shared" />
    <!-- What a Text Label says, between a note field and a drawn line. Shared
         because the server resolves the words and the panel shows the same
         answer the world does. -->
    <script src="shared/text_label.lua" type="shared" />
    <script src="server/connection_config.lua" type="server" />
    <script src="server/companion.lua" type="server" />
    <!-- Before the store: the store asks it for a verified copy before it
         migrates, and for the list of copies when it cannot open at all. -->
    <script src="server/backup.lua" type="server" />
    <script src="server/store.lua" type="server" />
    <script src="server/settings_store.lua" type="server" />
    <!-- Before everything that asks what is standing in the world: the link
         path, teleport and the study refresh all take their answer from it. -->
    <script src="server/world.lua" type="server" />
    <script src="server/map_identity.lua" type="server" />
    <script src="server/teleport.lua" type="server" />
    <script src="server/statistics.lua" type="server" />
    <!-- Which Map Entity is showing what in `Show text`. After the store it
         reads the links, the overrides and the cached words out of. -->
    <script src="server/text_labels.lua" type="server" />
    <script src="server/main.lua" type="server" />
    <!-- First on this side: every window asks it where it goes and how big it
         is, and the settings store hands it the stored scale and placement. -->
    <script src="client/layout.lua" type="client" cache="false" />
    <!-- Before the surfaces that leave their last outcome in it. -->
    <script src="client/diagnostics.lua" type="client" cache="false" />
    <script src="client/connection_status.lua" type="client" cache="false" />
    <script src="client/panel.lua" type="client" cache="false" />
    <script src="client/pick_entity.lua" type="client" cache="false" />
    <script src="client/review_mode.lua" type="client" cache="false" />
    <script src="client/activation.lua" type="client" cache="false" />
    <script src="client/indicator.lua" type="client" cache="false" />
    <!-- Everything ANKIGTA draws into the world, and the one distance it stops
         at. Before the polling below, which asks it whether a corona already
         marks a spot before the indicator puts a second mark on top of one. -->
    <script src="client/world_marks.lua" type="client" cache="false" />
    <!-- After it: a Text Label is drawn through one of its doors, is found by
         its look at the world, and holds back the `<KEY> to view` prompt on
         the entity it has taken. -->
    <script src="client/text_labels.lua" type="client" cache="false" />
    <!-- After both: it is the world-polling that feeds them, and it hands the
         indicator the source its markers follow. -->
    <script src="client/spatial.lua" type="client" cache="false" />
    <script src="client/recovery.lua" type="client" cache="false" />
    <!-- Last on this side: it puts the stored settings in force, so the
         modules it applies them to have to exist by then. -->
    <script src="client/settings_store.lua" type="client" cache="false" />
    <!-- After the store it reads from, and after the windows it opens over. -->
    <file src="client/panel/index.html" />
    <file src="client/panel/styles.css" />
    <file src="client/panel/app.js" />
    <map src="maps/ticket05.map" dimension="0" />
    <map src="maps/ticket07-matrix.map" dimension="0" />
    <export function="requestCompanionHealth" type="server" />
    <export function="requestCompanionCardPicker" type="server" />
    <export function="connectCompanion" type="server" />
    <export function="getCompanionConnectionStatus" type="server" />
    <export function="getStoreStatus" type="server" />
    <export function="prepareObjectPendingMapSave" type="server" />
    <export function="prepareVehiclePendingMapSave" type="server" />
    <export function="preparePedPendingMapSave" type="server" />
    <export function="linkCardToEntity" type="server" />
    <export function="resolveMapCopyDecision" type="server" />
    <export function="teleportPlayerToMapEntity" type="server" />
</meta>
